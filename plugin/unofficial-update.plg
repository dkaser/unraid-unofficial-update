<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="unofficial-update"
  author="Derek Kaser"
  version="2026.10.21.2309"
  
  pluginURL="https://raw.githubusercontent.com/dkaser/unraid-unofficial-update/main/plugin/unofficial-update.plg"
  support="https://forums.unraid.net/"
  min="7.3.0"
  
  icon="fa-cog"
>

<CHANGES>
<![CDATA[

### 2026.10.21.2309

- Update ca-certificates if needed

### 2026.10.21.2239

- Fix name in UI

### 1.0.0

- Initial release


For older releases, see https://github.com/dkaser/unraid-unofficial-update/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/unofficial-update/php-8.4.27-x86_64-1.txz">
<URL>https://raw.githubusercontent.com/dkaser/unraid-unofficial-update/refs/heads/main/pkg/php-8.4.27-x86_64-1.txz</URL>
<SHA256>bd336b3d3316c7ea2bc5dfd6d6fb2ea20ef33d123ec9cefb8d926e4043b80c69</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/unofficial-update/ca-certificates-20261020-noarch-1.txz">
<URL>https://raw.githubusercontent.com/dkaser/unraid-unofficial-update/refs/heads/main/pkg/ca-certificates-20261020-noarch-1.txz</URL>
<SHA256>12f46d6cd04d1333c2d941716c5dfe361a7b58774ac030e95fd14755230ad51f</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/unofficial-update/unraid-unofficial-update-2026.10.21.2309-noarch-1.txz">
<URL>https://github.com/dkaser/unraid-unofficial-update/releases/download/2026.10.21.2309/unraid-unofficial-update-2026.10.21.2309-noarch-1.txz</URL>
<SHA256>0a9f821a2079225bb7233a2612d16e4391713bec330169ef3847bd11e4b624ef</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/unofficial-update/unraid-unofficial-update-2026.10.21.2309-noarch-1.txz

# Only update older certificate bundles; preserve newer versions from the base OS.
ca_version=
for ca_package in /var/log/packages/ca-certificates-*-*-*; do
    [ -f "$ca_package" ] || continue
    ca_package=${ca_package##*/ca-certificates-}
    ca_package=${ca_package%-*-*}
    if [[ "$ca_package" > "$ca_version" ]]; then
        ca_version=$ca_package
    fi
done
if [[ -n "$ca_version" && "$ca_version" < "20261020" ]]; then
    upgradepkg /boot/config/plugins/unofficial-update/ca-certificates-20261020-noarch-1.txz || exit 1
fi

# Patch affected PHP versions and restart PHP-FPM after a successful upgrade.
if php -r 'exit(version_compare(PHP_VERSION, "8.4", ">") && version_compare(PHP_VERSION, "8.4.27", "<") ? 0 : 1);'; then
    upgradepkg --install-new /boot/config/plugins/unofficial-update/php-8.4.27-x86_64-1.txz || exit 1
    /etc/rc.d/rc.php-fpm restart || exit 1
fi

# cleanup old versions
rm -f $(ls /boot/config/plugins/unofficial-update/unraid-unofficial-update-*.txz 2>/dev/null | grep -v '2026.10.21.2309')
rm -f $(ls /boot/config/plugins/unofficial-update/docker-*.tgz 2>/dev/null | grep -v '')

echo ""
echo "----------------------------------------------------"
echo " unofficial-update has been installed."
echo " Version: 2026.10.21.2309"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
rm -rf /usr/local/emhttp/plugins/unofficial-update
rm -rf /boot/config/plugins/unofficial-update
]]>
</INLINE>
</FILE>

</PLUGIN>
