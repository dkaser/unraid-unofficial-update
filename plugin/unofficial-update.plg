<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/unofficial-update/unraid-unofficial-update-2026.10.21.2239-noarch-1.txz

# Patch affected PHP versions and restart PHP-FPM after a successful upgrade.
if php -r 'exit(version_compare(PHP_VERSION, "8.4", ">") && version_compare(PHP_VERSION, "8.4.27", "<") ? 0 : 1);'; then
    upgradepkg --install-new /boot/config/plugins/unofficial-update/php-8.4.27-x86_64-1.txz || exit 1
    /etc/rc.d/rc.php-fpm restart || exit 1
fi

# cleanup old versions
rm -f $(ls /boot/config/plugins/unofficial-update/unraid-unofficial-update-*.txz 2>/dev/null | grep -v '2026.10.21.2239')
rm -f $(ls /boot/config/plugins/unofficial-update/docker-*.tgz 2>/dev/null | grep -v '')

echo ""
echo "----------------------------------------------------"
echo " unofficial-update has been installed."
echo " Version: 2026.10.21.2239"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
rm -rf /usr/local/emhttp/plugins/unofficial-update
rm -rf /boot/config/plugins/unofficial-update
]]>
</INLINE>
</FILE>

</PLUGIN>
